<odoo>
<record id="school_fee_waiver_view_form" model="ir.ui.view">
    <field name="name">school_fee_waiver - form - admission</field>
    <field name="model">school_fee_waiver</field>
    <field name="inherit_id" ref="ssi_school_fee_waiver.school_fee_waiver_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='enrollment_id']" position="after">
                <field
                        name="admission_id"
                        domain="[('school_student_id', '=', student_id)]"
                        attrs="{'required': [('source_type', '=', 'admission')], 'invisible': [('source_type', '!=', 'admission')]}"
                    />
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute
                        name="attrs"
                    >{'invisible': ['|', ('coverage', '!=', 'single_term'), ('source_type', '!=', 'enrollment')], 'required': [('coverage', '=', 'single_term'), ('source_type', '=', 'enrollment')]}</attribute>
            </xpath>
            <xpath
                    expr="//field[@name='schedule_ids']/tree/field[@name='payment_term_id']"
                    position="after"
                >
                <field name="admission_payment_term_id" />
            </xpath>
            <xpath
                    expr="//field[@name='schedule_ids']/form//field[@name='payment_term_id']"
                    position="after"
                >
                <field name="admission_payment_term_id" />
            </xpath>
        </data>
    </field>
</record>
</odoo>
