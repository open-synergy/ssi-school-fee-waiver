<odoo>
<record id="school_fee_waiver_deduction_view_search" model="ir.ui.view">
    <field name="name">school_fee_waiver_deduction - search</field>
    <field name="model">school_fee_waiver_deduction</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="waiver_id" />
                <field name="student_id" />
                <field name="partner_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_waiver_id"
                            string="Waiver"
                            context="{'group_by': 'waiver_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_fee_waiver_deduction_view_tree" model="ir.ui.view">
    <field name="name">school_fee_waiver_deduction - tree</field>
    <field name="model">school_fee_waiver_deduction</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="waiver_id" />
                <field name="student_id" />
                <field name="partner_id" />
                <field name="amount_total" widget="monetary" />
                <field name="amount_allocated" widget="monetary" />
                <field name="amount_unallocated" widget="monetary" />
                <field name="reconciled" />
                <field name="currency_id" invisible="1" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_fee_waiver_deduction_view_form" model="ir.ui.view">
    <field name="name">school_fee_waiver_deduction - form</field>
    <field name="model">school_fee_waiver_deduction</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="waiver_id" />
                <field name="student_id" />
                <field name="partner_id" />
                <field name="journal_id" />
                <field name="receivable_account_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="currency_id" invisible="1" />
                <field name="company_currency_id" invisible="1" />
                <field
                        name="amount_total"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                <field
                        name="amount_allocated"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                <field
                        name="amount_unallocated"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                <field name="reconciled" />
                <field name="move_id" />
                <field name="receivable_move_line_id" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="line" string="Lines">
                    <field name="line_ids" colspan="4" nolabel="1">
                        <tree editable="bottom">
                            <field
                                    name="schedule_id"
                                    domain="[('waiver_id', '=', parent.waiver_id)]"
                                />
                            <field name="account_id" />
                            <field name="analytic_account_id" />
                            <field name="amount" widget="monetary" />
                            <field name="move_line_id" />
                            <field name="currency_id" invisible="1" />
                        </tree>
                        <form>
                            <group col="2">
                                <field
                                        name="schedule_id"
                                        domain="[('waiver_id', '=', parent.waiver_id)]"
                                    />
                                <field name="account_id" />
                                <field name="analytic_account_id" />
                                <field name="amount" widget="monetary" />
                                <field name="move_line_id" />
                                <field name="currency_id" invisible="1" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="allocation" string="Allocations">
                    <field name="allocation_ids" colspan="4" nolabel="1">
                        <tree editable="bottom">
                            <field name="customer_invoice_id" />
                            <field name="amount" widget="monetary" />
                            <field name="move_line_id" />
                            <field name="currency_id" invisible="1" />
                        </tree>
                        <form>
                            <group col="2">
                                <field name="customer_invoice_id" />
                                <field name="amount" widget="monetary" />
                                <field name="move_line_id" />
                                <field name="currency_id" invisible="1" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="schedule" string="Realized Schedule">
                    <field name="schedule_ids" colspan="4" nolabel="1">
                        <tree create="false" edit="false" delete="false">
                            <field name="line_id" />
                            <field name="date" />
                            <field name="amount_planned" />
                            <field name="amount_realized" />
                            <field name="state" />
                        </tree>
                        <form>
                            <group col="2">
                                <field name="line_id" />
                                <field name="date" />
                                <field name="amount_planned" />
                                <field name="amount_realized" />
                                <field name="state" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>
</odoo>
