<odoo>
<record id="school_enrollment_view_form" model="ir.ui.view">
    <field name="name">school_enrollment - form fee waiver</field>
    <field name="model">school_enrollment</field>
    <field name="inherit_id" ref="ssi_school.school_enrollment_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//group[@name='billing_amount']" position="after">
                <group
                        name="fee_waiver_amount"
                        string="Fee Waiver"
                        colspan="4"
                        col="2"
                        groups="ssi_school_fee_waiver.school_fee_waiver_viewer_group"
                    >
                    <group name="fee_waiver_amount_left" colspan="1">
                        <field name="amount_fee_waiver" readonly="1" />
                        <field name="amount_fee_waiver_deducted" readonly="1" />
                        <field name="amount_fee_waiver_undeducted" readonly="1" />
                    </group>
                </group>
            </xpath>
        </data>
    </field>
</record>
</odoo>
