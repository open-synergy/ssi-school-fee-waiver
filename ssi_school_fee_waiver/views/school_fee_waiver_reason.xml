<odoo>
<record id="school_fee_waiver_reason_view_tree" model="ir.ui.view">
    <field name="name">school_fee_waiver_reason - tree</field>
    <field name="model">school_fee_waiver_reason</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="before">
                <field name="sequence" widget="handle" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_fee_waiver_reason_view_form" model="ir.ui.view">
    <field name="name">school_fee_waiver_reason - form</field>
    <field name="model">school_fee_waiver_reason</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="sequence" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_fee_waiver_reason_action" model="ir.actions.act_window">
    <field name="name">Fee Waiver Reasons</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_fee_waiver_reason</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_fee_waiver_reason_menu"
        name="Fee Waiver Reasons"
        parent="menu_school_fee_waiver_configuration"
        action="school_fee_waiver_reason_action"
        groups="school_fee_waiver_configurator_group"
        sequence="20"
    />

</odoo>
